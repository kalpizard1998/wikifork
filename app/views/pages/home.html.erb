          </button>

          <!-- Subitems -->
          <div class="my-2 ml-12 flex flex-col space-y-4">
            <a href="/users" class="font-bold"><span>Todos</span></a>
            <a href="/users/new"><span>Nuevo</span></a>
            <a href="/users/roles"><span>Roles</span></a>
          </div>
        </div>

        <!-- Item con submenu (cerrado) -->
        <div>
          <button class="flex flex-row items-center p-2 rounded-lg w-full justify-between hover:bg-zinc-100">
            <div class="flex flex-row space-x-4 items-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
              <span class="font-semibold text-xl">Configuración</span>
            </div>
            <svg class="transition-transform duration-200" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <!-- subitems ocultos aquí -->
        </div>

      </div>
    </div>
  </div>

  <!-- MarginWidthWrapper + PageWrapper -->
  <div class="flex flex-col ml-60 border-r border-zinc-700 min-h-screen w-full">
    <div class="flex flex-col pt-2 px-4 space-y-2 bg-zinc-100 flex-grow pb-4">

      <!-- Tu contenido va aquí -->
      <h1 class="text-2xl font-bold">Contenido</h1>

    </div>
  </div>

</div> %>

