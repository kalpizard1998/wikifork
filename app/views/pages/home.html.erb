<%# <!-- Sidebar cerrada por defecto, toggle con botón -->
<div
  data-controller="sidebar"
  data-sidebar-open-value="false"
  data-sidebar-opened-class="bg-zinc-700 text-white"
  class="flex h-screen"
>
  <!-- Botón toggle -->
  <button
    data-action="click->sidebar#toggleSidebar"
    data-sidebar-target="active"
    class="fixed top-4 left-4 z-50 p-2 rounded-md bg-zinc-800 text-white transition-colors duration-200"
  >
    ☰ Menú
  </button>

  <!-- Panel lateral -->
  <div
    data-sidebar-target="sidebarContent"
    class="fixed top-0 left-0 h-full w-64 bg-zinc-900 text-white shadow-xl z-40 p-6 pt-16 flex flex-col gap-4"
  >
    <nav class="flex flex-col gap-2">
      <a href="#" class="px-4 py-2 rounded-md hover:bg-zinc-700 transition-colors">Inicio</a>
      <a href="#" class="px-4 py-2 rounded-md hover:bg-zinc-700 transition-colors">Proyectos</a>
      <a href="#" class="px-4 py-2 rounded-md hover:bg-zinc-700 transition-colors">Configuración</a>
    </nav>
  </div>
</div>

<!-- Sidebar abierta por defecto, con botones separados de abrir/cerrar -->
<div
  data-controller="sidebar"
  data-sidebar-open-value="true"
  class="flex"
>
  <button
    data-action="click->sidebar#openSidebar"
    data-sidebar-target="openButton"
    class="m-4 px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700"
  >
    Abrir sidebar
  </button>

  <button
    data-action="click->sidebar#closeSidebar"
    data-sidebar-target="closeButton"
    class="m-4 px-4 py-2 bg-red-600 text-white rounded-md hover:bg-red-700"
  >
    Cerrar sidebar
  </button>

  <aside
    data-sidebar-target="sidebarContent"
    class="w-64 bg-zinc-100 border-r border-zinc-300 h-screen p-6"
  >
    <p class="text-sm text-zinc-500">Contenido del sidebar</p>
  </aside>
</div> %>


















<%# <!-- 1. Hover (mouseenter/mouseleave) -->
<div data-controller="sidebar" data-sidebar-open-value="false" data-sidebar-opened-class="bg-zinc-400">
  <div role="button"
    data-action="mouseenter->sidebar#toggleSidebar mouseleave->sidebar#toggleSidebar"
    data-sidebar-target="active"
    class="px-4 py-2 rounded-md cursor-pointer transition-colors duration-200">
    Hover tooltip
  </div>
  <div data-sidebar-target="sidebarContent" class="fixed p-4 rounded-md bg-red-700 text-white">
    <p>Contenido del sidebar</p>
  </div>
</div>

<!-- 2. Click toggle -->
<div data-controller="sidebar" data-sidebar-open-value="true" data-sidebar-opened-class="bg-zinc-400">
  <div role="button"
    data-action="click->sidebar#toggleSidebar"
    data-sidebar-target="active"
    class="px-4 py-2 rounded-md cursor-pointer transition-colors duration-200">
    Toggle el sidebar
  </div>
  <div data-sidebar-target="sidebarContent">
    <p>Contenido del sidebar</p>
  </div>
</div>

<!-- 3. Botones separados abrir/cerrar -->
<div data-controller="sidebar">
  <div role="button"
    data-action="click->sidebar#openSidebar"
    data-sidebar-target="openButton"
    class="px-4 py-2 rounded-md cursor-pointer">
    Abrir
  </div>
  <button
    data-action="click->sidebar#closeSidebar"
    data-sidebar-target="closeButton"
    class="px-4 py-2 bg-zinc-400 rounded-md">
    Cerrar
  </button>
  <div data-sidebar-target="sidebarContent">
    <p>Contenido del sidebar</p>
  </div>
</div> %>




<%# 

<!-- Layout wrapper -->
<div class="flex">

  <!-- SideNav -->
  <div class="w-60 bg-white h-screen flex-1 fixed top-16 left-0 border-r border-zinc-200">
    <div class="flex flex-col space-y-6 w-full">

      <!-- Logo -->
      <a href="/" class="flex flex-row space-x-3 items-center px-6 border-b border-zinc-200 h-12 w-full">
        <span class="h-7 w-7 bg-zinc-300 rounded-lg"></span>
        <span class="font-bold text-xl">Logo</span>
      </a>

      <!-- Nav items -->
      <div class="flex flex-col space-y-2 px-6">

        <!-- Item simple -->
        <a href="/dashboard" class="flex flex-row space-x-4 items-center p-2 rounded-lg hover:bg-zinc-100 bg-zinc-100">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>
          <span class="font-semibold text-xl">Dashboard</span>
        </a>

        <!-- Item simple -->
        <a href="/projects" class="flex flex-row space-x-4 items-center p-2 rounded-lg hover:bg-zinc-100">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
          <span class="font-semibold text-xl">Proyectos</span>
