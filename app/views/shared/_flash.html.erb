

<% flash.each do |type, message| %>
  <div 
    data-controller="flash"
    class="flex items-center fixed top-5 right-5 z-50
           <%= classes_for_flash(type) %>
           py-3 px-5 rounded-lg shadow-lg transition-all duration-300">

    <!-- Mensaje -->
    <div class="mr-4 font-medium">
      <%= message %>
    </div>

    <!-- Botón cerrar -->
    <button 
      type="button"
      data-action="flash#dismiss"
      class="ml-2 hover:opacity-70">

      <svg xmlns="http://www.w3.org/2000/svg" 
           class="h-5 w-5" 
           fill="none" 
           viewBox="0 0 24 24" 
           stroke="currentColor">
        <path stroke-linecap="round" 
              stroke-linejoin="round" 
              stroke-width="2" 
              d="M6 18L18 6M6 6l12 12" />
      </svg>

    </button>
  </div>
<% end %>